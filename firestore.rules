rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // For maps keyed by user id (reactions, poll votes, status viewers):
    // this update only touches the caller's own entry.
    function onlyOwnEntryChanged(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {}))
        .affectedKeys().hasOnly([request.auth.uid]);
    }

    function ownEntryIsTimestamp(field) {
      return !(request.auth.uid in request.resource.data.get(field, {})) ||
             request.resource.data.get(field, {})[request.auth.uid] is timestamp;
    }

    function validJpegDataUrl(v) {
      return v is string && v.size() < 100000 && v.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // ---------------- users ----------------
    // A profile photo, if set, must be a small JPEG data URL (see makeAvatar
    // in app.js), never a link to somewhere else.
    // Only the fields this update changes are checked, so an old lastSeen
    // doesn't block e.g. a nickname change.
    function validProfileFields(data, changed) {
      return (!changed.hasAny(['avatar']) || !('avatar' in data) || validJpegDataUrl(data.avatar)) &&
             (!changed.hasAny(['hidePresence']) || data.hidePresence is bool) &&
             (!changed.hasAny(['hideReadReceipts']) || data.hideReadReceipts is bool) &&
             (!changed.hasAny(['about']) || !('about' in data) || (data.about is string && data.about.size() <= 140)) &&
             // lastSeen can only be "now" as set by the server, not a made-up time.
             (!changed.hasAny(['lastSeen']) || !('lastSeen' in data) || data.lastSeen == request.time);
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.blocked == {} &&
        (
          (
            request.resource.data.referredBy != null &&
            request.resource.data.status == "pending" &&
            get(/databases/$(database)/documents/users/$(request.resource.data.referredBy)).data.status == "approved"
          ) ||
          (
            request.resource.data.referredBy == null &&
            request.resource.data.status == "approved" &&
            !exists(/databases/$(database)/documents/meta/bootstrap)
          )
        );

      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['nickname', 'blocked', 'avatar', 'lastSeen', 'hidePresence', 'hideReadReceipts', 'about']) &&
         validProfileFields(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())) ||
        (request.auth.uid == resource.data.referredBy &&
         resource.data.status == "pending" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == "approved")
      );

      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.referredBy &&
        resource.data.status == "pending";
    }

    // ---------------- meta/bootstrap (one-time gate, never editable) ----------------
    match /meta/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/meta/bootstrap);
      allow update, delete: if false;
    }

    // ---------------- conversations ----------------
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2 &&
        request.resource.data.participants.size() <= 20;

      // Groups made before admins existed treat their creator as the admin.
      function groupAdmins() {
        return resource.data.get('admins', [resource.data.get('createdBy', '')]);
      }

      function isGroupConv() {
        return resource.data.get('isGroup', false) == true;
      }

      function adminsWithinParticipants(d) {
        return d.get('admins', []).toSet().difference(d.participants.toSet()).size() == 0;
      }

      // Joining a group with its invite code: the caller adds only
      // themselves (and their own nickname / unread entry), giving the code.
      function joinsWithInviteCode() {
        return isGroupConv() &&
          !(request.auth.uid in resource.data.participants) &&
          resource.data.get('inviteCode', '') is string && resource.data.get('inviteCode', '').size() >= 16 &&
          request.resource.data.get('joinCode', '') == resource.data.inviteCode &&
          changedKeys().hasOnly(['participants', 'participantNicknames', 'unreadCount', 'updatedAt', 'joinCode']) &&
          request.resource.data.participants.toSet() == resource.data.participants.toSet().union([request.auth.uid].toSet()) &&
          request.resource.data.participants.size() <= 20 &&
          onlyOwnEntryChanged('participantNicknames') && onlyOwnEntryChanged('unreadCount');
      }

      allow update: if isSignedIn() && (joinsWithInviteCode() || (request.auth.uid in resource.data.participants && (
        // pinnedMessage: the id of the message pinned to the top of the chat.
        (changedKeys().hasOnly(['unreadCount', 'typing', 'updatedAt', 'participantNicknames', 'disappearingSeconds', 'muted', 'pinnedMessage']) &&
         (!changedKeys().hasAny(['pinnedMessage']) || !('pinnedMessage' in request.resource.data) ||
          (request.resource.data.pinnedMessage is string && request.resource.data.pinnedMessage.size() <= 64))) ||
        // Group admins: name, photo, members and admins.
        (isGroupConv() && request.auth.uid in groupAdmins() &&
         changedKeys().hasOnly(['groupName', 'groupAvatar', 'participants', 'admins', 'participantNicknames', 'unreadCount', 'updatedAt', 'inviteCode']) &&
         (!changedKeys().hasAny(['inviteCode']) || !('inviteCode' in request.resource.data) ||
          (request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() >= 16 && request.resource.data.inviteCode.size() <= 64)) &&
         request.resource.data.participants.size() >= 1 && request.resource.data.participants.size() <= 20 &&
         request.resource.data.get('admins', []).size() >= 1 &&
         adminsWithinParticipants(request.resource.data) &&
         (!changedKeys().hasAny(['groupName']) || (request.resource.data.groupName is string && request.resource.data.groupName.size() <= 60)) &&
         (!changedKeys().hasAny(['groupAvatar']) || !('groupAvatar' in request.resource.data) || validJpegDataUrl(request.resource.data.groupAvatar))) ||
        // Anyone may leave a group: remove only themselves. A leaving admin
        // may hand admin to others; anyone else leaves the admins alone.
        (isGroupConv() &&
         changedKeys().hasOnly(['participants', 'admins', 'participantNicknames', 'unreadCount', 'updatedAt']) &&
         request.resource.data.participants.toSet() == resource.data.participants.toSet().difference([request.auth.uid].toSet()) &&
         ((request.auth.uid in groupAdmins() && adminsWithinParticipants(request.resource.data)) ||
          (!(request.auth.uid in groupAdmins()) && !changedKeys().hasAny(['admins']))))
      )));

      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      // ---------------- messages ----------------
      // Also holds the chunk documents of large photos/files ({ from, chunkOf,
      // idx, data }, see sendEncryptedTo in app.js); the create rule covers them.
      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);

        allow create: if isConversationParticipant(conversationId) &&
          request.resource.data.from == request.auth.uid;

        allow update: if isConversationParticipant(conversationId) && (
          // read / delivered / voice message played receipts, set by the recipient.
          (changedKeys().hasOnly(['read', 'delivered', 'played']) && resource.data.from != request.auth.uid) ||
          (resource.data.from == request.auth.uid &&
           changedKeys().hasOnly(['deleted', 'deletedAt', 'edited', 'editedAt', 'ciphertext', 'iv', 'wrappedKeys'])) ||
          // Each person may only change their own reaction or poll vote.
          (changedKeys().hasOnly(['reactions']) && onlyOwnEntryChanged('reactions')) ||
          // Event replies: yes / maybe / no, each person only their own.
          (changedKeys().hasOnly(['rsvp']) && resource.data.get('type', '') == 'event' && onlyOwnEntryChanged('rsvp') &&
           (!(request.auth.uid in request.resource.data.rsvp) || request.resource.data.rsvp[request.auth.uid] in ['yes', 'maybe', 'no'])) ||
          // Group read / delivered receipts: each member adds only their own time.
          (changedKeys().hasOnly(['readBy', 'deliveredTo']) && resource.data.from != request.auth.uid &&
           onlyOwnEntryChanged('readBy') && onlyOwnEntryChanged('deliveredTo') &&
           ownEntryIsTimestamp('readBy') && ownEntryIsTimestamp('deliveredTo')) ||
          (changedKeys().hasOnly(['votes']) && resource.data.get('type', '') == 'poll' && onlyOwnEntryChanged('votes') &&
           (!(request.auth.uid in request.resource.data.votes) || request.resource.data.votes[request.auth.uid] is int ||
            // Multiple-choice polls: a list of option indexes.
            (request.resource.data.votes[request.auth.uid] is list && request.resource.data.votes[request.auth.uid].size() <= 10)))
        );

        allow delete: if isConversationParticipant(conversationId);
      }
    }

    // ---------------- statuses (24-hour stories) ----------------
    // Encrypted for an audience (the author's contacts); only they and the
    // author can read one, only the author can delete it, and viewers may
    // only add themselves to "viewers".
    match /statuses/{statusId} {
      allow read: if isSignedIn() &&
        (resource.data.from == request.auth.uid || request.auth.uid in resource.data.audience);

      allow create: if isSignedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.audience is list && request.resource.data.audience.size() <= 500 &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(25, 'h') &&
        !('viewers' in request.resource.data);

      allow update: if isSignedIn() && request.auth.uid in resource.data.audience &&
        changedKeys().hasOnly(['viewers']) && onlyOwnEntryChanged('viewers');

      allow delete: if isSignedIn() && resource.data.from == request.auth.uid;

      // Encrypted pieces of a video status ({ from, idx, data }). Written
      // before the status itself, so they carry their own author.
      match /chunks/{chunkId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/statuses/$(statusId)).data.from == request.auth.uid ||
           request.auth.uid in get(/databases/$(database)/documents/statuses/$(statusId)).data.audience);
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid &&
          request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow delete: if isSignedIn() && resource.data.from == request.auth.uid;
      }
    }

    // ---------------- calls ----------------
    match /calls/{callId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);

      allow create: if isSignedIn() && request.auth.uid == request.resource.data.from;

      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);

      match /callerCandidates/{candidateId} {
        allow read, create: if isSignedIn() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.from ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.to);
      }
      match /calleeCandidates/{candidateId} {
        allow read, create: if isSignedIn() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.from ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.to);
      }
    }
  }
}
